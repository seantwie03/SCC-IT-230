{
    "name": "slidev-theme-it230",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "license": "MIT",
    "scripts": {
        "build": "node scripts/build-theme.mjs",
        "capture": "node scripts/capture-theme.mjs",
        "dev": "slidev example.md --port 2020",
        "export": "slidev export example.md --output dist/gallery.pdf",
        "review": "node scripts/review-theme.mjs",
        "test": "node scripts/check-theme.mjs"
    },
    "keywords": [
        "slidev-theme",
        "slidev"
    ],
    "engines": {
        "slidev": ">=52.18.0"
    },
    "slidev": {
        "colorSchema": "light",
        "defaults": {
            "aspectRatio": "16/9",
            "favicon": "./favicon.svg",
            "lineNumbers": true,
            "preloadImages": false
        }
    }
}
