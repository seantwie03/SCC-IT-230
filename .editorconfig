root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
insert_final_newline = true

[*.{yml,yaml,yml.j2,yaml.j2}]
indent_size = 2

[*.md]
indent_size = unset
trim_trailing_whitespace = false

[*.org]
indent_size = unset
trim_trailing_whitespace = false

[*-lock.json]
indent_size = unset

