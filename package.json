{
    "name": "scc-it-230",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "license": "MIT",
    "packageManager": "pnpm@11.18.0",
    "engines": {
        "node": "24.x"
    },
    "scripts": {
        "build": "pnpm run build:theme && pnpm run build:site",
        "build:deck": "node scripts/build-deck.mjs",
        "build:site": "node scripts/build-site.mjs",
        "build:theme": "pnpm --filter slidev-theme-it230 build",
        "capture:course": "node scripts/capture-course.mjs",
        "capture:theme": "pnpm --filter slidev-theme-it230 capture",
        "check": "pnpm run check:format && pnpm run check:toolchain && pnpm run test && pnpm run build && pnpm run check:links",
        "check:format": "prettier --check .",
        "check:links": "node scripts/check-links.mjs",
        "check:toolchain": "node scripts/check-toolchain.mjs",
        "dev": "node scripts/serve-course.mjs dev",
        "dev:theme": "pnpm --filter slidev-theme-it230 dev",
        "export:pdf": "node scripts/export-deck.mjs",
        "export:theme": "pnpm --filter slidev-theme-it230 export",
        "format": "prettier --write .",
        "preview": "node scripts/preview-site.mjs",
        "review": "node scripts/serve-course.mjs review",
        "review:theme": "pnpm --filter slidev-theme-it230 review",
        "test": "pnpm run test:theme && pnpm run test:site",
        "test:site": "node --test tests/site.test.mjs && node scripts/check-site.mjs",
        "test:theme": "pnpm --filter slidev-theme-it230 test",
        "test:theme:all": "pnpm --filter slidev-theme-it230 test:accents"
    },
    "devDependencies": {
        "@playwright/mcp": "0.0.78",
        "@slidev/cli": "52.18.0",
        "@slidev/types": "52.18.0",
        "playwright-chromium": "1.62.0",
        "prettier": "3.9.6",
        "shiki": "4.3.1",
        "slidev-theme-it230": "workspace:*",
        "vue": "3.5.40"
    }
}
