# Allow the maintainer-approved validation, local-review, generated-output, and
# formatting scripts to run outside the sandbox without an approval prompt.
prefix_rule(
    pattern = [
        "pnpm",
        "run",
        [
            "build",
            "build:theme",
            "capture:course",
            "capture:theme",
            "check",
            "check:format",
            "check:toolchain",
            "export:theme",
            "format",
            "review",
            "review:theme",
            "test",
            "test:site",
            "test:theme",
            "test:theme:all",
        ],
    ],
    decision = "allow",
    justification = "The maintainer approved these validation, local-review, generated-output, and formatting scripts.",
    match = [
        "pnpm run build",
        "pnpm run build:theme",
        "pnpm run capture:course -- course/w01.md",
        "pnpm run capture:course -- course/w01.md 1,4-7",
        "pnpm run capture:theme",
        "pnpm run capture:theme -- 1,4-7",
        "pnpm run check",
        "pnpm run check:format",
        "pnpm run check:toolchain",
        "pnpm run export:theme",
        "pnpm run format",
        "pnpm run review",
        "pnpm run review -- course/w01.md",
        "pnpm run review:theme",
        "pnpm run test",
        "pnpm run test:site",
        "pnpm run test:theme",
        "pnpm run test:theme:all",
    ],
    not_match = [
        "pnpm run dev:theme",
        "pnpm run dev",
        "pnpm run preview",
    ],
)

# Allow the same maintainer-approved scripts through pnpm's shorthand form.
prefix_rule(
    pattern = [
        "pnpm",
        [
            "build",
            "build:theme",
            "capture:course",
            "capture:theme",
            "check",
            "check:format",
            "check:toolchain",
            "export:theme",
            "format",
            "review",
            "review:theme",
            "test",
            "test:site",
            "test:theme",
            "test:theme:all",
        ],
    ],
    decision = "allow",
    justification = "The maintainer approved these validation, local-review, generated-output, and formatting scripts.",
    match = [
        "pnpm build",
        "pnpm build:theme",
        "pnpm capture:course -- course/w01.md",
        "pnpm capture:course -- course/w01.md 1,4-7",
        "pnpm capture:theme",
        "pnpm capture:theme -- 1,4-7",
        "pnpm check",
        "pnpm check:format",
        "pnpm check:toolchain",
        "pnpm export:theme",
        "pnpm format",
        "pnpm review",
        "pnpm review -- course/w01.md",
        "pnpm review:theme",
        "pnpm test",
        "pnpm test:site",
        "pnpm test:theme",
        "pnpm test:theme:all",
    ],
    not_match = [
        "pnpm dev:theme",
        "pnpm dev",
        "pnpm preview",
    ],
)

# Allow dependency installation only when pnpm must honor the existing public repository lockfile.
prefix_rule(
    pattern = ["pnpm", "install", "--frozen-lockfile"],
    decision = "allow",
    justification = "The maintainer approved frozen-lockfile installation for the public repository.",
    match = ["pnpm install --frozen-lockfile"],
    not_match = [
        "pnpm install",
        "pnpm install --no-frozen-lockfile",
        "pnpm update",
    ],
)

# Allow Playwright browser installation for PDF export testing.
prefix_rule(
    pattern = ["pnpm", "exec", "playwright", "install"],
    decision = "allow",
    justification = "The maintainer approved Playwright browser installation.",
    match = [
        "pnpm exec playwright install",
        "pnpm exec playwright install chromium",
    ],
)

