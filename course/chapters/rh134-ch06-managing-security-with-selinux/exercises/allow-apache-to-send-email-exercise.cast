[0,"o","\r\u001b[1;34m\u001b[0m                                                                                                                        \u001b[1;34m########################################################################################################################\u001b[0m\u001b[1;34m    Exercise: Allow Apache to Send Email\u001b[0m                                                                                \u001b[1;34m        Requirements\u001b[0m                                                                                                    \u001b[1;34m          Host: servera\u001b[0m                                                                                                 \u001b[1;34m          Allow Apache to send email\u001b[0m"]
[0.000216,"o","                                                                                    \u001b[1;34m        Steps\u001b[0m                                                                                                           \u001b[1;34m          1. Find the appropriate SELinux boolean\u001b[0m                                                                       \u001b[1;34m          2. View the current value of the boolean\u001b[0m                                                                      \u001b[1;34m          3. Permanently set the boolean to allow Apache to send mail\u001b[0m                                                   \u001b[1;34m          4. Verify the boolean is set\u001b[0m                                                                                  "]
[0.000053,"o","\u001b[1;34m          5. Clean up\u001b[0m                                                                                                   \u001b[1;34m########################################################################################################################\u001b[0m"]
