[0.0164,"o","\u001b[01;31m\u001b[Khttpd\u001b[m\u001b[K_helper_selinux (8) - Security Enhanced Linux Policy for the \u001b[01;31m\u001b[Khttpd\u001b[m\u001b[K_helper processes\r\n\u001b[01;31m\u001b[Khttpd\u001b[m\u001b[K_passwd_selinux (8) - Security Enhanced Linux Policy for the \u001b[01;31m\u001b[Khttpd\u001b[m\u001b[K_passwd processes\r\n\u001b[01;31m\u001b[Khttpd\u001b[m\u001b[K_php_selinux (8) - Security Enhanced Linux Policy for the \u001b[01;31m\u001b[Khttpd\u001b[m\u001b[K_php processes\r\n\u001b[01;31m\u001b[Khttpd\u001b[m\u001b[K_rotatelogs_selinux (8) - Security Enhanced Linux Policy for the \u001b[01;31m\u001b[Khttpd\u001b[m\u001b[K_rotatelogs processes\r\n\u001b[01;31m\u001b[Khttpd\u001b[m\u001b[K_selinux (8)    - Security Enhanced Linux Policy for the \u001b[01;31m\u001b[Khttpd\u001b[m\u001b[K processes\r\n\u001b[01;31m\u001b[Khttpd\u001b[m\u001b[K_suexec_selinux (8) - Security Enhanced Linux Policy for the \u001b[01;31m\u001b[Khttpd\u001b[m\u001b[K_suexec processes\r\n\u001b[01;31m\u001b[Khttpd\u001b[m\u001b[K_sys_script_selinux (8) - Security Enhanced Linux Policy for the \u001b[01;31m\u001b[Khttpd\u001b[m\u001b[K_sys_script processes\r\n\u001b[01;31m\u001b[Khttpd\u001b[m\u001b[K_unconfined_script_selinux (8) - Security Enhanced Linux Policy for the \u001b[01;31m\u001b[Khttpd\u001b[m\u001b[K_unconfined_script processes\r\n\u001b[01;31m\u001b[Khttpd\u001b[m\u001b[K_user_script_selinux (8) - Security Enhanced Linux Policy for the \u001b[01;31m\u001b[Khttpd\u001b[m\u001b[K_user_script processes\r\n"]
[0.006519,"o","\u001b]0;student@servera:~\u0007\u001b[?2004h[student@servera ~]$ "]
[3.010995,"o","man 8 httpd_selinux"]
[3.035246,"o","\r\n\u001b[?2004l\r"]
[0.014445,"o","\u001b[?1049h\u001b[24;1H\u001b[?1h\r"]
[0.013479,"o","\u001b[4mhttpd_selinux\u001b[24m(8)                                 SELinux Policy httpd                                \u001b[4mhttpd_selinux\u001b[24m(8)\u001b[m\r\n\u001b[m\r\n\u001b[1mNAME\u001b[0m\u001b[m\r\n       httpd_selinux - Security Enhanced Linux Policy for the httpd processes\u001b[m\r\n\u001b[m\r\n\u001b[1mDESCRIPTION\u001b[0m\u001b[m\r\n       Security-Enhanced Linux secures the httpd processes via flexible mandatory access control.\u001b[m\r\n\u001b[m\r\n       The  httpd  processes execute with the httpd_t SELinux type. You can check if you have these processes running\u001b[m\r\n       by executing the \u001b[1mps \u001b[22mcommand with the \u001b[1m-Z \u001b[22mqualifier.\u001b[m\r\n\u001b[m\r\n       For example:\u001b[m\r\n\u001b[m\r\n       \u001b[1mps -eZ | grep httpd_t\u001b[0m\u001b[m\r\n\u001b[m\r\n\u001b[1mENTRYPOINTS\u001b[0m\u001b[m\r\n       The httpd_t SELinux type can be entered via the \u001b[1mhttpd_exec_t \u001b[22mfile type.\u001b[m\r\n\u001b[m\r\n       The default entrypoint paths for the httpd_t domain are the following:\u001b[m\r\n\u001b[m\r\n       /usr/sbin/httpd(.worker)?,     /usr/sbin/apache(2)?,     /usr/lib/apache-ssl/.+,     /usr/sbin/apache-ssl(2)?,\u001b[m\r\n       /usr/sbin/nginx,      /usr/sbin/thttpd,     /usr/sbin/php-fpm,     /usr/sbin/cherokee,     /usr/sbin/lighttpd,\u001b[m\r\n       /usr/sbin/apachectl, /usr/sbin/httpd.event, /usr/bin/mongrel_rails, /usr/sbin/htcacheclean\u001b[m\r\n\u001b[7m Manual page httpd_selinux(8) line 1 (press h for help or q to quit)\u001b[27m\u001b[K"]
[3.011058,"o","\r\u001b[K/\u001b[Km\bm"]
[0.000083,"o","\u001b[Ka\ba\u001b[Ki\bi\u001b[Kl\bl"]
[3.032648,"o","\r\u001b[K\u001b[1;1H\u001b[K\u001b[4mhttpd_selinux\u001b[24m(8)                                 SELinux Policy httpd                                \u001b[4mhttpd_selinux\u001b[24m(8)\u001b[m\r\n\u001b[2;1H\u001b[K\u001b[m\r\n\u001b[3;1H\u001b[K\u001b[1mNAME\u001b[0m\u001b[m\r\n"]
[0.000043,"o","\u001b[4;1H\u001b[K       httpd_selinux - Security Enhanced Linux Policy for the httpd processes\u001b[m\r\n\u001b[5;1H\u001b[K\u001b[m\r\n\u001b[6;1H\u001b[K\u001b[1mDESCRIPTION\u001b[0m\u001b[m\r\n\u001b[7;1H\u001b[K       Security-Enhanced Linux secures the httpd processes via flexible mandatory access control.\u001b[m\r\n\u001b[8;1H\u001b[K\u001b[m"]
[0.000098,"o","\r\n\u001b[9;1H\u001b[K       The  httpd  processes execute with the httpd_t SELinux type. You can check if you have these processes running\u001b[m\r\n\u001b[10;1H\u001b[K       by executing the \u001b[1mps \u001b[22mcommand with the \u001b[1m-Z \u001b[22mqualifier.\u001b[m\r\n\u001b[11;1H\u001b[K\u001b[m\r\n\u001b[12;1H\u001b[K       For example:\u001b[m\r\n\u001b[13;1H\u001b[K\u001b[m\r\n\u001b[14;1H\u001b[K       \u001b[1mps -eZ | grep httpd_t\u001b[0m\u001b[m"]
[0.00018,"o","\r\n\u001b[15;1H\u001b[K\u001b[m\r\n\u001b[16;1H\u001b[K\u001b[1mENTRYPOINTS\u001b[0m\u001b[m\r\n\u001b[17;1H\u001b[K       The httpd_t SELinux type can be entered via the \u001b[1mhttpd_exec_t \u001b[22mfile type.\u001b[m\r\n\u001b[18;1H\u001b[K\u001b[m\r\n\u001b[19;1H\u001b[K       The default entrypoint paths for the httpd_t domain are the following:\u001b[m\r\n"]
[0.000172,"o","\u001b[20;1H\u001b[K\u001b[m\r\n\u001b[21;1H\u001b[K       /usr/sbin/httpd(.worker)?,     /usr/sbin/apache(2)?,     /usr/lib/apache-ssl/.+,     /usr/sbin/apache-ssl(2)?,\u001b[m\r\n\u001b[22;1H\u001b[K       /usr/sbin/nginx,      /usr/sbin/thttpd,     /usr/sbin/php-fpm,     /usr/sbin/cherokee,     /usr/sbin/lighttpd,\u001b[m\r\n\u001b[23;1H\u001b[K       /usr/sbin/apachectl, /usr/sbin/httpd.event, /usr/bin/mongrel_rails, /usr/sbin/htcacheclean\u001b[m\r\n\u001b[24;1H\u001b[1;1H\u001b[K\u001b[4mhttpd_selinux\u001b[24m(8)                                 SELinux Policy httpd                                \u001b[4mhttpd_selinux\u001b[24m(8)\u001b[m"]
[0.000183,"o","\r\n\u001b[2;1H\u001b[K\u001b[m\r\n\u001b[3;1H\u001b[K\u001b[1mNAME\u001b[0m\u001b[m\r\n\u001b[4;1H\u001b[K       httpd_selinux - Security Enhanced Linux Policy for the httpd processes\u001b[m\r\n\u001b[5;1H\u001b[K\u001b[m\r\n\u001b[6;1H\u001b[K\u001b[1mDESCRIPTION\u001b[0m\u001b[m\r\n\u001b[7;1H\u001b[K       Security-Enhanced Linux secures the httpd processes via flexible mandatory access control.\u001b[m"]
[0.000149,"o","\r\n\u001b[8;1H\u001b[K\u001b[m\r\n\u001b[9;1H\u001b[K       The  httpd  processes execute with the httpd_t SELinux type. You can check if you have these processes running\u001b[m\r\n\u001b[10;1H\u001b[K       by executing the \u001b[1mps \u001b[22mcommand with the \u001b[1m-Z \u001b[22mqualifier.\u001b[m\r\n\u001b[11;1H\u001b[K\u001b[m\r\n\u001b[12;1H\u001b[K       For example:\u001b[m\r\n\u001b[13;1H\u001b[K\u001b[m"]
[0.000003,"o","\r\n\u001b[14;1H\u001b[K       \u001b[1mps -eZ | grep httpd_t\u001b[0m\u001b[m"]
[0.000091,"o","\r\n\u001b[15;1H\u001b[K\u001b[m\r\n\u001b[16;1H\u001b[K\u001b[1mENTRYPOINTS\u001b[0m\u001b[m\r\n\u001b[17;1H\u001b[K       The httpd_t SELinux type can be entered via the \u001b[1mhttpd_exec_t \u001b[22mfile type.\u001b[m\r\n\u001b[18;1H\u001b[K\u001b[m\r\n\u001b[19;1H\u001b[K       The default entrypoint paths for the httpd_t domain are the following:\u001b[m\r\n"]
[0.000007,"o","\u001b[20;1H\u001b[K\u001b[m"]
[0.000008,"o","\r\n"]
[0.000004,"o","\u001b[21;1H\u001b[K       /usr/sbin/httpd(.worker)?,     /usr/sbin/apache(2)?,     /usr/lib/apache-ssl/.+,     /usr/sbin/apache-ssl(2)?,\u001b[m"]
[0.000026,"o","\r\n"]
[0.00001,"o","\u001b[22;1H\u001b[K       /usr/sbin/nginx,      /usr/sbin/thttpd,     /usr/sbin/php-fpm,     /usr/sbin/cherokee,     /usr/sbin/lighttpd,\u001b[m\r\n"]
[0.000119,"o","\u001b[23;1H\u001b[K       /usr/sbin/apachectl, /usr/sbin/httpd.event, /usr/bin/mongrel_rails, /usr/sbin/htcacheclean\u001b[m\r\n\u001b[24;1H...skipping..."]
[0.000017,"o","\r\n"]
[0.000006,"o","       If  you  want  to allow http daemon to send \u001b[7mmail\u001b[27m, you must turn on the httpd_can_send\u001b[7mmail\u001b[27m boolean. Disabled by\u001b[m"]
[0.00002,"o","\r\n"]
[0.000009,"o","       default.\u001b[m"]
[0.000014,"o","\r\n"]
[0.000013,"o","\u001b[m"]
[0.000013,"o","\r\n"]
[0.000013,"o","       \u001b[1msetsebool -P httpd_can_send\u001b[7mmail\u001b[27m\u001b[1m 1\u001b[0m\u001b[m"]
[0.000007,"o","\r\n"]
[0.000014,"o","\u001b[m\r\n"]
[0.000027,"o","       If you want to allow Apache to communicate with avahi service via dbus, you must turn on the  httpd_dbus_avahi\u001b[m\r\n       boolean. Disabled by default.\u001b[m\r\n\u001b[m\r\n       \u001b[1msetsebool -P httpd_dbus_avahi 1\u001b[0m\u001b[m\r\n\u001b[m\r\n"]
[0.000026,"o","       If  you  want  to allow Apache to communicate with sssd service via dbus, you must turn on the httpd_dbus_sssd\u001b[m\r\n       boolean. Disabled by default.\u001b[m\r\n\u001b[m\r\n       \u001b[1msetsebool -P httpd_dbus_sssd 1\u001b[0m\u001b[m\r\n\u001b[m\r\n       If you want to dontaudit Apache to search dirs, you must turn on the httpd_dontaudit_search_dirs boolean. Dis‐\u001b[m\r\n       abled by default.\u001b[m\r\n\u001b[m"]
[0.00003,"o","\r\n       \u001b[1msetsebool -P httpd_dontaudit_search_dirs 1\u001b[0m\u001b[m\r\n\u001b[m\r\n       If you want to allow httpd cgi support, you must turn on the httpd_enable_cgi boolean. Enabled by default.\u001b[m\r\n\u001b[m\r\n"]
[0.000018,"o","       \u001b[1msetsebool -P httpd_enable_cgi 1\u001b[0m\u001b[m"]
[0.000016,"o","\r\n\u001b[7m Manual page httpd_selinux(8) line 104 (press h for help or q to quit)\u001b[27m\u001b[K"]
