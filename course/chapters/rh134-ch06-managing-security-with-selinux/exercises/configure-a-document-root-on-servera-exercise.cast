[0,"o","\r\u001b[1;34m\u001b[0m                                                                                                                        \u001b[1;34m########################################################################################################################\u001b[0m\u001b[1;34m    Exercise: Configure a New DocumentRoot for Apache on servera\u001b[0m                                                        \u001b[1;34m        Requirements\u001b[0m                                                                                                    \u001b[1;34m          Host: servera\u001b[0m"]
[0.000017,"o","                                                                                                 \u001b[1;34m          Configure Apache to serve content from the /website directory\u001b[0m"]
[0.000189,"o","                                                 \u001b[1;34m        Steps\u001b[0m                                                                                                           \u001b[1;34m          1. Install httpd and start its service\u001b[0m                                                                        \u001b[1;34m          2. Make a /website directory with an HTML file\u001b[0m                                                                \u001b[1;34m          3. Configure Apache to serve /website\u001b[0m"]
[0.000061,"o","                                                                         \u001b[1;34m          4. Test and troubleshoot: switch SELinux to permissive temporarily\u001b[0m                                            \u001b[1;34m          5. Troubleshoot: use sealert\u001b[0m"]
[0.000024,"o","                                                                                  "]
[0.000031,"o","\u001b[1;34m          6. Configure a policy to set httpd_sys_content_t on /website(/.*)? files\u001b[0m                                      "]
[0.000199,"o","\u001b[1;34m          7. Apply the policy to the files\u001b[0m                                                                              \u001b[1;34m          8. Verify the results\u001b[0m                                                                                         \u001b[1;34m          9. Clean up\u001b[0m                                                                                                   \u001b[1;34m########################################################################################################################\u001b[0m"]
