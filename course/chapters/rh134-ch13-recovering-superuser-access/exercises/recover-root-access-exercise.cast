[0,"o","\r\u001b[1;34m\u001b[0m                                                                                                                        \u001b[1;34m########################################################################################################################\u001b[0m"]
[0.000103,"o","\u001b[1;34m    Exercise: Recover Root Access\u001b[0m                                                                                       "]
[0.000144,"o","\u001b[1;34m        Requirements\u001b[0m                                                                                                    "]
[0.000021,"o","\u001b[1;34m          Host: servera, with its VM console open\u001b[0m"]
[0.000148,"o","                                                                       \u001b[1;34m          Prerequisite exercise: Change Kernel Arguments\u001b[0m                                                                "]
[0.000044,"o","\u001b[1;34m          Lock root out of servera, then get back in by booting with init=/bin/bash\u001b[0m"]
[0.000047,"o","                                     "]
[0.000049,"o","\u001b[1;34m        Steps\u001b[0m"]
[0.000046,"o","                                                                                                           "]
[0.000053,"o","\u001b[1;34m          1. Lock the root account and confirm a console login fails\u001b[0m"]
[0.000041,"o","                                                    "]
[0.000051,"o","\u001b[1;34m          2. Boot once with init=/bin/bash added at the GRUB2 menu\u001b[0m"]
[0.000045,"o","                                                      "]
[0.000057,"o","\u001b[1;34m          3. Remount the root file system read/write\u001b[0m"]
[0.000039,"o","                                                                    "]
[0.000045,"o","\u001b[1;34m          4. Reset the root password\u001b[0m"]
[0.000064,"o","                                                                                    "]
[0.000035,"o","\u001b[1;34m          5. Schedule an SELinux relabel\u001b[0m"]
[0.000048,"o","                                                                                "]
[0.000045,"o","\u001b[1;34m          6. Hand control to systemd and wait for the relabel and reboot\u001b[0m"]
[0.000047,"o","                                                "]
[0.000071,"o","\u001b[1;34m          7. Log in as root at the console\u001b[0m"]
[0.000281,"o","                                                                              \u001b[1;34m########################################################################################################################\u001b[0m"]
[0,"m","Exercise: Recover Root Access"]
