[0,"o","\r\u001b[1;34m\u001b[0m                                                                                                                        \u001b[1;34m########################################################################################################################\u001b[0m\u001b[1;34m    Exercise: Per-User Automounting\u001b[0m"]
[0.000019,"o","                                                                                     \u001b[1;34m        Requirements\u001b[0m"]
[0.00005,"o","                                                                                                    \u001b[1;34m          Hosts: servera (server), workstation (client)\u001b[0m"]
[0.00004,"o","                                                                 "]
[0.000005,"o","\u001b[1;34m          Prerequisite exercises: Configure an Indirect Map, UID-Based Access Control\u001b[0m"]
[0.000016,"o","                                   "]
[0.000038,"o","\u001b[1;34m          Give each user an automounted directory of their own from one map entry\u001b[0m"]
[0.000011,"o","                                       "]
[0.000024,"o","\u001b[1;34m        Steps\u001b[0m"]
[0.000021,"o","                                                                                                           "]
[0.000014,"o","\u001b[1;34m          1. On servera, create /srv/usershares with a directory for each user\u001b[0m"]
[0.000027,"o","                                          "]
[0.000014,"o","\u001b[1;34m          2. Export the parent directory to the subnet\u001b[0m"]
[0.000036,"o","                                                                  "]
[0.000026,"o","\u001b[1;34m          3. On workstation, confirm con_john and dev_jane match their servera UIDs and GIDs\u001b[0m"]
[0.000012,"o","                            "]
[0.000159,"o","\u001b[1;34m          4. Configure a wildcard indirect map for /nfs/usershares\u001b[0m                                                      \u001b[1;34m          5. Restart autofs\u001b[0m                                                                                             \u001b[1;34m          6. As each user, verify your own directory mounts on access\u001b[0m                                                   \u001b[1;34m          7. Verify neither user can use the other's directory\u001b[0m"]
[0.000007,"o","                                                          "]
