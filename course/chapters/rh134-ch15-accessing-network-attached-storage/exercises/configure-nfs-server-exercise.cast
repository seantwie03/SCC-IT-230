[0.189949, "o", "\r\u001b[1;34m\u001b[0m"]
[0.000029, "o", "                                                                                                                        "]
[0.000008, "o", "\u001b[1;34m########################################################################################################################\u001b[0m"]
[0.000269, "o", "\u001b[1;34m    Exercise: Configure an NFS Server\u001b[0m                                                                                   \u001b[1;34m        Requirements\u001b[0m                                                                                                    "]
[0.000111, "o", "\u001b[1;34m          Host: servera\u001b[0m                                                                                                 \u001b[1;34m          Share a directory on servera with the lab network\u001b[0m"]
[0.000401, "o", "                                                             \u001b[1;34m        Steps\u001b[0m                                                                                                           \u001b[1;34m          1. Install nfs-utils\u001b[0m                                                                                          \u001b[1;34m          2. Create /srv/reports and give it to student\u001b[0m                                                                 \u001b[1;34m          3. Export it read/write to 172.25.250.0/24\u001b[0m"]
[0.000192, "o", "                                                                    \u001b[1;34m          4. Enable and start the nfs-server service\u001b[0m                                                                    "]
[0.000058, "o", "\u001b[1;34m          5. Open the firewall for NFS\u001b[0m                                                                                  "]
[0.000005, "o", "\u001b[1;34m          6. Verify the export with exportfs -v\u001b[0m"]
[0.000228, "o", "                                                                         \u001b[1;34m########################################################################################################################\u001b[0m"]
[0.034817, "o", "\r\n\u001b[?2004l\r"]
[0.000198, "o", "\u001b]0;student@servera:~\u0007\u001b[?2004h[student@servera ~]$ "]
