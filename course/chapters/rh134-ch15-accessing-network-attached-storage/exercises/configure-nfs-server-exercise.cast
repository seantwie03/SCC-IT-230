[0,"o","\u001b[1;34m########################################################################################################################\u001b[0m"]
[0.000211,"o","\u001b[1;34m    Exercise: Configure an NFS Server\u001b[0m                                                                                   \u001b[1;34m        Requirements\u001b[0m                                                                                                    \u001b[1;34m          Host: servera\u001b[0m                                                                                                 \u001b[1;34m          Share a directory on servera with the lab network\u001b[0m"]
[0.000024,"o","                                                             "]
[0.000015,"o","\u001b[1;34m        Steps\u001b[0m"]
[0.00003,"o","                                                                                                           "]
[0.000024,"o","\u001b[1;34m          1. Install nfs-utils\u001b[0m"]
[0.000011,"o","                                                                                          "]
[0.00003,"o","\u001b[1;34m          2. Create /srv/reports and give it to student\u001b[0m"]
[0.00003,"o","                                                                 "]
[0.00001,"o","\u001b[1;34m          3. Export it read/write to 172.25.250.0/24\u001b[0m"]
[0.000026,"o","                                                                    "]
[0.000029,"o","\u001b[1;34m          4. Enable and start the nfs-server service\u001b[0m"]
[0.000011,"o","                                                                    "]
[0.000044,"o","\u001b[1;34m          5. Open the firewall for NFS\u001b[0m                                                                                  "]
[0.000022,"o","\u001b[1;34m          6. Verify the export with exportfs -v\u001b[0m"]
[0.000029,"o","                                                                         "]
