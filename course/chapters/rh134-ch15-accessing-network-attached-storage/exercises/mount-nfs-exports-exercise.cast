[0,"o","\u001b[1;34m########################################################################################################################\u001b[0m"]
[0.000156,"o","\u001b[1;34m    Exercise: Mount NFS Exports\u001b[0m                                                                                         "]
[0.000059,"o","\u001b[1;34m        Requirements\u001b[0m                                                                                                    "]
[0.000153,"o","\u001b[1;34m          Hosts: servera (server), workstation (client)\u001b[0m                                                                 \u001b[1;34m          Prerequisite exercise: Configure an NFS Server\u001b[0m"]
[0.000074,"o","                                                                \u001b[1;34m          Mount servera's export on workstation by hand, then at every boot\u001b[0m"]
[0.000104,"o","                                             \u001b[1;34m        Steps\u001b[0m"]
[0.000042,"o","                                                                                                           "]
[0.000068,"o","\u001b[1;34m          1. On workstation, install nfs-utils\u001b[0m"]
[0.000044,"o","                                                                          "]
[0.000065,"o","\u001b[1;34m          2. Verify servera's export is visible with showmount --exports\u001b[0m"]
[0.000132,"o","                                                "]
[0.000108,"o","\u001b[1;34m          3. Mount it on /nfs/reports and confirm student can write a file\u001b[0m                                              "]
[0.000036,"o","\u001b[1;34m          4. Unmount the export\u001b[0m"]
[0.000033,"o","                                                                                         \u001b[1;34m          5. Add the export to /etc/fstab with rw,sync,nofail options\u001b[0m"]
[0.00008,"o","                                                   \u001b[1;34m          6. Mount it from /etc/fstab and verify it is mounted\u001b[0m"]
[0.00005,"o","                                                          "]
[0.000109,"o","\u001b[1;34m          7. Reboot workstation and confirm the export mounts automatically\u001b[0m"]
[0.000036,"o","                                             "]
[0.000036,"o","\u001b[1;34m########################################################################################################################\u001b[0m"]
[0,"m","Exercise: Mount NFS Exports"]
