[0,"o","\r\u001b[1;34m\u001b[0m                                                                                                                        \u001b[1;34m########################################################################################################################\u001b[0m\u001b[1;34m    Exercise: Configure a Direct Map\u001b[0m"]
[0.000143,"o","                                                                                    \u001b[1;34m        Requirements\u001b[0m                                                                                                    "]
[0.000157,"o","\u001b[1;34m          Hosts: servera (server), workstation (client)\u001b[0m"]
[0.000182,"o","                                                                 \u001b[1;34m          Prerequisite exercise: Mount NFS Exports\u001b[0m                                                                      \u001b[1;34m          Have workstation mount a share at a fixed path the first time it is used\u001b[0m"]
[0.000007,"o","                                      "]
[0.000085,"o","\u001b[1;34m        Steps\u001b[0m                                                                                                           "]
[0.000035,"o","\u001b[1;34m          1. On servera, create /srv/manuals and export it\u001b[0m"]
[0.000006,"o","                                                              "]
[0.000049,"o","\u001b[1;34m          2. Reload the exports and verify with showmount --exports\u001b[0m                                                     "]
[0.000028,"o","\u001b[1;34m          3. On workstation, install autofs\u001b[0m"]
[0.000035,"o","                                                                             \u001b[1;34m          4. Create the master map file in /etc/auto.master.d/\u001b[0m"]
[0.000039,"o","                                                          "]
[0.000005,"o","\u001b[1;34m          5. Create the direct map for /nfs/manuals\u001b[0m"]
[0.000027,"o","                                                                     "]
[0.00003,"o","\u001b[1;34m          6. Enable and start the autofs service\u001b[0m"]
[0.000013,"o","                                                                        "]
[0.000026,"o","\u001b[1;34m          7. Verify the share is not mounted, then access the mount point\u001b[0m"]
[0.000013,"o","                                               "]
[0.000026,"o","\u001b[1;34m          8. Verify the share is now mounted\u001b[0m"]
[0.000019,"o","                                                                            "]
