[0.000079,"o","\u001b[1;34m    Exercise: Mount Web Content\u001b[0m                                                                                         "]
[0.000484,"o","\u001b[1;34m        Requirements\u001b[0m                                                                                                    \u001b[1;34m          Host: servera\u001b[0m                                                                                                 \u001b[1;34m          Prerequisite exercise: Build a Container Image\u001b[0m                                                                \u001b[1;34m          Serve a page straight from the host's disk through your own intranet:1.1 image\u001b[0m                                "]
[0.000043,"o","\u001b[1;34m        Steps\u001b[0m                                                                                                           "]
[0.000012,"o","\u001b[1;34m          1. Create a web page in ~/intranet/html\u001b[0m                                                                       "]
[0.000045,"o","\u001b[1;34m          2. Run intranet:1.1 with that directory mounted, and test it\u001b[0m"]
[0.000011,"o","                                                  "]
[0.000033,"o","\u001b[1;34m          3. Find out why the page is not served\u001b[0m"]
[0.00001,"o","                                                                        "]
[0.000037,"o","\u001b[1;34m          4. Run it again with :Z and test it\u001b[0m                                                                           "]
[0.000092,"o","\u001b[1;34m          5. Edit the page on the host twice, testing after each edit\u001b[0m                                                   \u001b[1;34m########################################################################################################################\u001b[0m"]
