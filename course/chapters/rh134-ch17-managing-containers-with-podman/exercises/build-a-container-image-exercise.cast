[0,"o","\u001b[1;34m########################################################################################################################\u001b[0m\u001b[1;34m    Exercise: Build a Container Image\u001b[0m                                                                                   \u001b[1;34m        Requirements\u001b[0m"]
[0.000021,"o","                                                                                                    "]
[0.000024,"o","\u001b[1;34m          Host: servera\u001b[0m"]
[0.000008,"o","                                                                                                 "]
[0.000051,"o","\u001b[1;34m          Prerequisite exercise: Manage a Container\u001b[0m                                                                     "]
[0.000034,"o","\u001b[1;34m          Build your own web server image, then change the page it serves\u001b[0m"]
[0.000008,"o","                                               "]
[0.000031,"o","\u001b[1;34m        Steps\u001b[0m"]
[0.000052,"o","                                                                                                           \u001b[1;34m          1. Write a page and a Containerfile that copies it into a UBI 10 image with httpd\u001b[0m"]
[0.000047,"o","                             \u001b[1;34m          2. Build it as intranet:1.0, run it with host port 8082, and test it\u001b[0m"]
[0.000023,"o","                                          "]
[0.000018,"o","\u001b[1;34m          3. Change the page and test again\u001b[0m"]
[0.000084,"o","                                                                             \u001b[1;34m          4. Build intranet:1.1 and replace the container with one from it\u001b[0m                                              "]
[0.000007,"o","\u001b[1;34m          5. Test again and list your images\u001b[0m"]
[0.00004,"o","                                                                            "]
[0.000031,"o","\u001b[1;34m########################################################################################################################\u001b[0m"]
