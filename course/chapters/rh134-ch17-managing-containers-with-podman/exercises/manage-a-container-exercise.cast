[0.000036,"o","\u001b[1;34m    Exercise: Manage a Container\u001b[0m                                                                                        "]
[0.000142,"o","\u001b[1;34m        Requirements\u001b[0m                                                                                                    \u001b[1;34m          Hosts: servera, workstation\u001b[0m"]
[0.00019,"o","                                                                                   \u001b[1;34m          Prerequisite exercise: Manage Container Images\u001b[0m"]
[0.000039,"o","                                                                \u001b[1;34m          Run, explore, and remove containers\u001b[0m                                                                           "]
[0.000251,"o","\u001b[1;34m        Steps\u001b[0m                                                                                                           \u001b[1;34m          1. Remove the stopped containers left from the first exercise\u001b[0m                                                 "]
[0.000086,"o","\u001b[1;34m          2. Run the httpd image in the foreground, then stop it\u001b[0m                                                        "]
[0.000027,"o","\u001b[1;34m          3. Run it in the background as intranet, publishing host port 8081\u001b[0m"]
[0.00022,"o","                                            \u001b[1;34m          4. Check it with curl and podman logs\u001b[0m                                                                         \u001b[1;34m          5. Open a shell in it and look around\u001b[0m                                                                         "]
[0.000231,"o","\u001b[1;34m          6. Reach it from workstation\u001b[0m                                                                                  \u001b[1;34m          7. Print an environment variable from a container that removes itself\u001b[0m"]
[0.000032,"o","                                         \u001b[1;34m          8. Stop and remove intranet\u001b[0m"]
[0.000246,"o","                                                                                   \u001b[1;34m########################################################################################################################\u001b[0m"]
