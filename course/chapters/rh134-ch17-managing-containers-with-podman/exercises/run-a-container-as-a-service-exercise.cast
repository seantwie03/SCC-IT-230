[0,"o","\r\u001b[1;34m\u001b[0m                                                                                                                        \u001b[1;34m########################################################################################################################\u001b[0m\u001b[1;34m    Exercise: Run a Container as a Service\u001b[0m"]
[0.000232,"o","                                                                              \u001b[1;34m        Requirements\u001b[0m                                                                                                    \u001b[1;34m          Host: servera\u001b[0m"]
[0.000165,"o","                                                                                                 \u001b[1;34m          Prerequisite exercise: Mount Web Content\u001b[0m"]
[0.000142,"o","                                                                      \u001b[1;34m          Serve a page from a container that starts at boot, as a service of a user of its own\u001b[0m"]
[0.000038,"o","                          "]
[0.000005,"o","\u001b[1;34m        Steps\u001b[0m"]
[0.000027,"o","                                                                                                           "]
[0.00028,"o","\u001b[1;34m          1. Create the user webapp with a password\u001b[0m                                                                     \u001b[1;34m          2. Log in as webapp with SSH and run a web container on host port 8083\u001b[0m                                        \u001b[1;34m          3. Generate a unit for the container and start it as a service\u001b[0m"]
[0.000019,"o","                                                "]
[0.000148,"o","\u001b[1;34m          4. Log out and test the page\u001b[0m                                                                                  "]
[0.000023,"o","\u001b[1;34m          5. Enable lingering for webapp and test again\u001b[0m"]
[0.000053,"o","                                                                 "]
[0.000172,"o","\u001b[1;34m          6. Reboot servera and test again\u001b[0m                                                                              "]
[0.000059,"o","\u001b[1;34m########################################################################################################################\u001b[0m"]
