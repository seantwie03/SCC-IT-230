[0.000478,"o","found 1 alerts in /var/log/audit/audit.log\r\n--------------------------------------------------------------------------------\r\n\r\nSELinux is preventing /usr/sbin/httpd from name_bind access on the tcp_socket port 8888.\r\n\r\n*****  Plugin bind_ports (92.2 confidence) suggests   ************************\r\n\r\nIf you want to allow /usr/sbin/httpd to bind to network port 8888\r\nThen you need to modify the port type.\r\nDo\r\n# semanage port -a -t PORT_TYPE -p tcp 8888\r\n    where PORT_TYPE is one of the following: http_cache_port_t, http_port_t, jboss_management_port_t, jboss_messaging_po \brt_t, ntop_port_t, puppet_port_t.\r\n\r\n*****  Plugin catchall_boolean (7.83 confidence) suggests   ******************\r\n\r\nIf you want to allow nis to enabled\r\nThen you must tell SELinux about this by enabling the 'nis_enabled' boolean.\r\n\r\nDo\r\nsetsebool -P nis_enabled 1\r\n\r\n:\u001b[K"]
[1.775086,"o","\r\u001b[K/\u001b[Kp\bp\u001b[Ko\bo\u001b[Kr\br\u001b[Kt\bt\u001b[K \b \u001b[K8\b8\u001b[K8\b8\u001b[K8\b8\u001b[K8\b8"]
[3.033197,"o","\r\u001b[K\u001b[1;1H\u001b[K\r\n\u001b[2;1H\u001b[Kfound 1 alerts in /var/log/audit/audit.log\r\n\u001b[3;1H\u001b[K--------------------------------------------------------------------------------\r\n\u001b[4;1H\u001b[K\r\n\u001b[5;1H\u001b[KSELinux is preventing /usr/sbin/httpd from name_bind access on the tcp_socket port 8888.\r\n\u001b[6;1H\u001b[K\r\n\u001b[7;1H\u001b[K*****  Plugin bind_ports (92.2 confidence) suggests   ************************\r\n\u001b[8;1H\u001b[K\r\n\u001b[9;1H\u001b[KIf you want to allow /usr/sbin/httpd to bind to network port 8888\r\n\u001b[10;1H\u001b[KThen you need to modify the port type.\r\n\u001b[11;1H\u001b[KDo\r\n\u001b[12;1H\u001b[K# semanage port -a -t PORT_TYPE -p tcp 8888\r\n\u001b[13;1H\u001b[K    where PORT_TYPE is one of the following: http_cache_port_t, http_port_t, jboss_management_port_t, jboss_messaging_po \b\u001b[14;1H\u001b[Krt_t, ntop_port_t, puppet_port_t.\r\n\u001b[15;1H\u001b[K\r\n\u001b[16;1H\u001b[K*****  Plugin catchall_boolean (7.83 confidence) suggests   ******************\r\n\u001b[17;1H\u001b[K\r\n\u001b[18;1H\u001b[KIf you want to allow nis to enabled\r\n\u001b[19;1H\u001b[KThen you must tell SELinux about this by enabling the 'nis_enabled' boolean.\r\n\u001b[20;1H\u001b[K\r\n\u001b[21;1H\u001b[KDo\r\n\u001b[22;1H\u001b[Ksetsebool -P nis_enabled 1\r\n\u001b[23;1H\u001b[K\r\n"]
[0.000005,"o","\u001b[24;1H\u001b[1;1H\u001b[K"]
[0.000147,"o","\r\n\u001b[2;1H\u001b[Kfound 1 alerts in /var/log/audit/audit.log\r\n\u001b[3;1H\u001b[K--------------------------------------------------------------------------------\r\n\u001b[4;1H\u001b[K\r\n\u001b[5;1H\u001b[KSELinux is preventing /usr/sbin/httpd from name_bind access on the tcp_socket \u001b[7mport 8888\u001b[27m.\r\n\u001b[6;1H\u001b[K\r\n\u001b[7;1H\u001b[K*****  Plugin bind_ports (92.2 confidence) suggests   ************************\r\n\u001b[8;1H\u001b[K\r\n\u001b[9;1H\u001b[KIf you want to allow /usr/sbin/httpd to bind to network \u001b[7mport 8888\u001b[27m\r\n\u001b[10;1H\u001b[KThen you need to modify the port type.\r\n\u001b[11;1H\u001b[KDo\r\n\u001b[12;1H\u001b[K# semanage port -a -t PORT_TYPE -p tcp 8888\r\n\u001b[13;1H\u001b[K    where PORT_TYPE is one of the following: http_cache_port_t, http_port_t, jboss_management_port_t, jboss_messaging_po \b\u001b[14;1H\u001b[Krt_t, ntop_port_t, puppet_port_t.\r\n\u001b[15;1H\u001b[K\r\n\u001b[16;1H\u001b[K*****  Plugin catchall_boolean (7.83 confidence) suggests   ******************\r\n\u001b[17;1H\u001b[K\r\n\u001b[18;1H\u001b[KIf you want to allow nis to enabled\r\n\u001b[19;1H\u001b[KThen you must tell SELinux about this by enabling the 'nis_enabled' boolean.\r\n"]
[0.000211,"o","\u001b[20;1H\u001b[K\r\n\u001b[21;1H\u001b[KDo\r\n\u001b[22;1H\u001b[Ksetsebool -P nis_enabled 1\r\n\u001b[23;1H\u001b[K\r\n\u001b[24;1H*****  Plugin catchall (1.41 confidence) suggests   **************************\r\n\r\nIf you believe that httpd should be allowed name_bind access on the \u001b[7mport 8888\u001b[27m tcp_socket by default.\r\nThen you should report this as a bug.\r\n:\u001b[K"]
