[0,"o","\r\u001b[1;34m\u001b[0m                                                                                                                        \u001b[1;34m########################################################################################################################\u001b[0m\u001b[1;34m    Exercise: Serve a Web Page on a Custom Port\u001b[0m                                                                         \u001b[1;34m        Requirements\u001b[0m"]
[0.000017,"o","                                                                                                    "]
[0.000026,"o","\u001b[1;34m          Host: workstation, from servera\u001b[0m"]
[0.000064,"o","                                                                               "]
[0.000048,"o","\u001b[1;34m          Serve a page from workstation on port 8484 and reach it from servera\u001b[0m                                          "]
[0.000018,"o","\u001b[1;34m        Steps\u001b[0m"]
[0.00018,"o","                                                                                                           \u001b[1;34m          1. Install httpd and write a page\u001b[0m                                                                             \u001b[1;34m          2. Point Apache's Listen line at 8484\u001b[0m                                                                         \u001b[1;34m          3. Open 8484/tcp in the firewall\u001b[0m"]
[0.000022,"o","                                                                              \u001b[1;34m          4. Label 8484 for SELinux\u001b[0m"]
[0.000218,"o","                                                                                     \u001b[1;34m          5. Start httpd\u001b[0m                                                                                                \u001b[1;34m          6. Request the page from servera\u001b[0m                                                                              \u001b[1;34m          7. Put workstation back the way you found it\u001b[0m                                                                  \u001b[1;34m########################################################################################################################\u001b[0m"]
