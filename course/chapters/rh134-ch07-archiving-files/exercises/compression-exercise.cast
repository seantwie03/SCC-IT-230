[0,"o","\u001b[1;34m########################################################################################################################\u001b[0m\u001b[1;34m    Exercise: Comparing Compression Algorithms\u001b[0m"]
[0.000027,"o","                                                                          "]
[0.000202,"o","\u001b[1;34m        Requirements\u001b[0m                                                                                                    "]
[0.000031,"o","\u001b[1;34m          Host: servera\u001b[0m                                                                                                 "]
[0.000015,"o","\u001b[1;34m          Prerequisite: Creating and Extracting Archives\u001b[0m"]
[0.000227,"o","                                                                \u001b[1;34m          Find which compressor makes the smallest /etc backup, and at what cost\u001b[0m"]
[0.000013,"o","                                        \u001b[1;34m        Steps\u001b[0m                                                                                                           "]
[0.00016,"o","\u001b[1;34m          1. gzip with -z\u001b[0m                                                                                               "]
[0.000206,"o","\u001b[1;34m          2. bzip2 with -j, after installing it\u001b[0m                                                                         "]
[0.000014,"o","\u001b[1;34m          3. xz with -J\u001b[0m                                                                                                 \u001b[1;34m          4. Compare all four archives\u001b[0m"]
[0.000186,"o","                                                                                  \u001b[1;34m          5. Ask gzip and xz for their ratios\u001b[0m                                                                           "]
[0.00006,"o","\u001b[1;34m          6. Extract without naming the algorithm\u001b[0m"]
[0.000019,"o","                                                                       "]
[0.000231,"o","\u001b[1;34m          7. Clean up\u001b[0m                                                                                                   \u001b[1;34m########################################################################################################################\u001b[0m"]
