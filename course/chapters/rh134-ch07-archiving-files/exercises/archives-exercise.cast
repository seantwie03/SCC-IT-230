[0.000078,"o","                                                                                                 "]
[0.000218,"o","\u001b[1;34m          Back up /etc and restore it somewhere safe\u001b[0m"]
[0.000065,"o","                                                                    "]
[0.000041,"o","\u001b[1;34m        Steps\u001b[0m"]
[0.000014,"o","                                                                                                           "]
[0.000046,"o","\u001b[1;34m          1. Bundle all of /etc as root into one uncompressed archive under /tmp\u001b[0m"]
[0.000011,"o","                                        "]
[0.000054,"o","\u001b[1;34m          2. Check the size of the archive you produced\u001b[0m"]
[0.000012,"o","                                                                 "]
[0.000043,"o","\u001b[1;34m          3. Read the archive's contents without unpacking it\u001b[0m"]
[0.00001,"o","                                                           "]
[0.000041,"o","\u001b[1;34m          4. Unpack the archive into an empty directory of its own\u001b[0m"]
[0.000038,"o","                                                      "]
[0.000018,"o","\u001b[1;34m          5. Confirm the extracted tree looks like the original\u001b[0m"]
[0.000034,"o","                                                         "]
[0.000023,"o","\u001b[1;34m          6. Extract a single file into a fresh directory\u001b[0m"]
[0.000027,"o","                                                               "]
