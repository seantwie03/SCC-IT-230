[0,"o","                                                                                                                        \u001b[1;34m########################################################################################################################\u001b[0m"]
[0.000186,"o","\u001b[1;34m    Exercise: Creating and Extracting Archives\u001b[0m                                                                          \u001b[1;34m        Requirements\u001b[0m"]
[0.000192,"o","                                                                                                    \u001b[1;34m          Host: servera\u001b[0m                                                                                                 "]
[0.000039,"o","\u001b[1;34m          Back up /etc and restore it somewhere safe\u001b[0m                                                                    "]
[0.000023,"o","\u001b[1;34m        Steps\u001b[0m"]
[0.000154,"o","                                                                                                           \u001b[1;34m          1. Bundle all of /etc as root into one uncompressed archive under /tmp\u001b[0m"]
[0.000014,"o","                                        "]
[0.000281,"o","\u001b[1;34m          2. Check the size of the archive you produced\u001b[0m"]
[0.000026,"o","                                                                 "]
[0.00007,"o","\u001b[1;34m          3. Read the archive's contents without unpacking it\u001b[0m                                                           "]
[0.000017,"o","\u001b[1;34m          4. Unpack the archive into an empty directory of its own\u001b[0m"]
[0.000022,"o","                                                      "]
[0.000015,"o","\u001b[1;34m          5. Confirm the extracted tree looks like the original\u001b[0m"]
[0.00006,"o","                                                         \u001b[1;34m          6. Extract a single file into a fresh directory\u001b[0m"]
[0.000006,"o","                                                               "]
[0.000068,"o","\u001b[1;34m########################################################################################################################\u001b[0m"]
[0,"m","Exercise: Creating and Extracting Archives"]
