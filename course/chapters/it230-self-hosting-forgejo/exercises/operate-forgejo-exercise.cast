[0,"o","\u001b[1;34m########################################################################################################################\u001b[0m\u001b[1;34m    Exercise: Operate Forgejo\u001b[0m                                                                                           "]
[0.000033,"o","\u001b[1;34m        Requirements\u001b[0m                                                                                                    "]
[0.000047,"o","\u001b[1;34m          Hosts: serverb, servera\u001b[0m                                                                                       \u001b[1;34m          Prerequisite exercise: Build the Web Tier\u001b[0m                                                                     "]
[0.000034,"o","\u001b[1;34m          Back up Forgejo's database and files to servera every night, and read the web tier's log\u001b[0m                      \u001b[1;34m        Steps\u001b[0m"]
[0.000049,"o","                                                                                                           \u001b[1;34m          1. Install rsync on serverb and servera\u001b[0m                                                                       \u001b[1;34m          2. Write a script that backs up the database and files, keeps the seven newest, and copies them to servera\u001b[0m"]
[0.000036,"o","    \u001b[1;34m          3. Run it by hand under nice, and check the copy on servera\u001b[0m                                                   "]
[0.000064,"o","\u001b[1;34m          4. Schedule it nightly in /etc/cron.d\u001b[0m                                                                         \u001b[1;34m          5. Rotate the backup's log with logrotate\u001b[0m                                                                     "]
[0.000006,"o","\u001b[1;34m          6. Search servera's access log for errors\u001b[0m"]
[0.000027,"o","                                                                     \u001b[1;34m########################################################################################################################\u001b[0m"]
