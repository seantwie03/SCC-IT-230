[0,"o","\u001b[1;34m########################################################################################################################\u001b[0m\u001b[1;34m    Exercise: Build the App Tier\u001b[0m"]
[0.000202,"o","                                                                                        \u001b[1;34m        Requirements\u001b[0m                                                                                                    "]
[0.000041,"o","\u001b[1;34m          Host: servera\u001b[0m"]
[0.000076,"o","                                                                                                 "]
[0.000089,"o","\u001b[1;34m          Prerequisite exercise: Build the Data Tier\u001b[0m                                                                    "]
[0.000122,"o","\u001b[1;34m          Run Forgejo in a container, as a service of a user of its own, with all of its data on serverb\u001b[0m                "]
[0.000097,"o","\u001b[1;34m        Steps\u001b[0m                                                                                                           "]
[0.000133,"o","\u001b[1;34m          1. Install Podman, autofs, and the NFS client\u001b[0m                                                                 "]
[0.000017,"o","\u001b[1;34m          2. Create the user forgejo, with UID 2000, a password, and lingering\u001b[0m"]
[0.000064,"o","                                          "]
[0.000063,"o","\u001b[1;34m          3. Automount Forgejo's files from serverb on forgejo's ~/data\u001b[0m"]
[0.000029,"o","                                                 "]
[0.000057,"o","\u001b[1;34m          4. Run Forgejo in a container as the forgejo user\u001b[0m"]
[0.000054,"o","                                                             "]
[0.000058,"o","\u001b[1;34m          5. Create Forgejo's first admin\u001b[0m"]
[0.000051,"o","                                                                               "]
[0.000053,"o","\u001b[1;34m          6. Run the container as a user service that starts at boot\u001b[0m"]
[0.00006,"o","                                                    "]
