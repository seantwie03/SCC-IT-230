[0,"o","\r\u001b[1;34m\u001b[0m                                                                                                                        \u001b[1;34m########################################################################################################################\u001b[0m\u001b[1;34m    Exercise: Build the Data Tier\u001b[0m                                                                                       \u001b[1;34m        Requirements\u001b[0m                                                                                                    "]
[0.000018,"o","\u001b[1;34m          Host: serverb\u001b[0m                                                                                                 "]
[0.000045,"o","\u001b[1;34m          Hold all of Forgejo's data: its database in PostgreSQL, and its files shared to servera over NFS\u001b[0m"]
[0.000003,"o","              "]
[0.000072,"o","\u001b[1;34m        Steps\u001b[0m                                                                                                           \u001b[1;34m          1. Tune serverb for throughput performance\u001b[0m"]
[0.000023,"o","                                                                    "]
[0.000051,"o","\u001b[1;34m          2. Install PostgreSQL and the NFS server\u001b[0m                                                                      "]
[0.00002,"o","\u001b[1;34m          3. Create logical volumes for PostgreSQL's data and Forgejo's files\u001b[0m"]
[0.000016,"o","                                           "]
[0.00003,"o","\u001b[1;34m          4. Prepare the logical volume for PostgreSQL\u001b[0m"]
[0.00001,"o","                                                                  "]
[0.000033,"o","\u001b[1;34m          5. Initialize PostgreSQL on its logical volume\u001b[0m"]
[0.000009,"o","                                                                "]
[0.000037,"o","\u001b[1;34m          6. Allow the forgejo user to connect to PostgreSQL from servera\u001b[0m"]
[0.000014,"o","                                               "]
[0.000038,"o","\u001b[1;34m          7. Start PostgreSQL and create the forgejo user and database\u001b[0m                                                  "]
[0.00005,"o","\u001b[1;34m          8. Share Forgejo's logical volume with servera over NFS\u001b[0m                                                       "]
[0.000044,"o","\u001b[1;34m          9. Open the firewall for PostgreSQL and NFS\u001b[0m                                                                   "]
[0.000025,"o","\u001b[1;34m########################################################################################################################\u001b[0m"]
