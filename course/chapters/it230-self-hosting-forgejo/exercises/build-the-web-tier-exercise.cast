[3.001202,"o","\r\u001b[K\u001b[1;1H\u001b[K\r\n\u001b[2;1H\u001b[Kfound 1 alerts in /var/log/audit/audit.log\r\n\u001b[3;1H\u001b[K--------------------------------------------------------------------------------\r\n\u001b[4;1H\u001b[K"]
[0.000085,"o","\r\n"]
[0.00006,"o","\u001b[5;1H\u001b[KSELinux is preventing /usr/sbin/httpd from name_connect access on the tcp_socket port 3000.\r\n\u001b[6;1H\u001b[K\r\n\u001b[7;1H\u001b[K*****  Plugin catchall_boolean (89.3 confidence) suggests   ******************\r\n\u001b[8;1H\u001b[K\r\n\u001b[9;1H\u001b[KIf you want to allow httpd to can network connect\r\n\u001b[10;1H\u001b[KThen you must tell SELinux about this by enabling the 'httpd_can_network_connect' boolean.\r\n\u001b[11;1H\u001b[K\r\n\u001b[12;1H\u001b[KDo\r\n\u001b[13;1H\u001b[Ksetsebool -P httpd_can_network_connect 1"]
[0.000086,"o","\r\n\u001b[14;1H\u001b[K\r\n\u001b[15;1H\u001b[K*****  Plugin catchall (11.6 confidence) suggests   **************************\r\n\u001b[16;1H\u001b[K\r\n\u001b[17;1H\u001b[KIf you believe that httpd should be allowed name_connect access on the port 3000 tcp_socket by default.\r\n\u001b[18;1H\u001b[KThen you should report this as a bug.\r\n\u001b[19;1H\u001b[KYou can generate a local policy module to allow this access.\r\n\u001b[20;1H\u001b[KDo\r\n\u001b[21;1H\u001b[Kallow this access for now by executing:\r\n\u001b[22;1H\u001b[K# ausearch -c 'httpd' --raw | audit2allow -M my-httpd"]
[0.000155,"o","\r\n\u001b[23;1H\u001b[K# semodule -X 300 -i my-httpd.pp\r\n\u001b[24;1H\u001b[1;1H\u001b[K"]
[0.000154,"o","\r\n\u001b[2;1H\u001b[Kfound 1 alerts in /var/log/audit/audit.log\r\n\u001b[3;1H\u001b[K--------------------------------------------------------------------------------\r\n\u001b[4;1H\u001b[K\r\n\u001b[5;1H\u001b[KSELinux is preventing /usr/sbin/httpd from name_connect access on the tcp_socket \u001b[7mport 3000\u001b[27m.\r\n\u001b[6;1H\u001b[K\r\n\u001b[7;1H\u001b[K*****  Plugin catchall_boolean (89.3 confidence) suggests   ******************\r\n\u001b[8;1H\u001b[K\r\n\u001b[9;1H\u001b[KIf you want to allow httpd to can network connect\r\n\u001b[10;1H\u001b[KThen you must tell SELinux about this by enabling the 'httpd_can_network_connect' boolean.\r\n\u001b[11;1H\u001b[K\r\n\u001b[12;1H\u001b[KDo\r\n\u001b[13;1H\u001b[Ksetsebool -P httpd_can_network_connect 1\r\n\u001b[14;1H\u001b[K\r\n\u001b[15;1H\u001b[K*****  Plugin catchall (11.6 confidence) suggests   **************************\r\n\u001b[16;1H\u001b[K\r\n\u001b[17;1H\u001b[KIf you believe that httpd should be allowed name_connect access on the \u001b[7mport 3000\u001b[27m tcp_socket by default.\r\n\u001b[18;1H\u001b[KThen you should report this as a bug.\r\n\u001b[19;1H\u001b[KYou can generate a local policy module to allow this access.\r\n\u001b[20;1H\u001b[KDo\r\n\u001b[21;1H\u001b[Kallow this access for now by executing:\r\n\u001b[22;1H\u001b[K# ausearch -c 'httpd' --raw | audit2allow -M my-httpd\r\n\u001b[23;1H\u001b[K# semodule -X 300 -i my-httpd.pp\r\n\u001b[24;1H\r\n\r\nAdditional Information:\r\nSource Context                system_u:system_r:httpd_t:s0\r\n:\u001b[K"]
