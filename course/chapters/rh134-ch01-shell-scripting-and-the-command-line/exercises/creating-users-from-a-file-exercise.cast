[0,"o","\u001b[1;34m########################################################################################################################\u001b[0m\u001b[1;34m    Exercise: Creating Users from a File\u001b[0m                                                                                \u001b[1;34m        Requirements\u001b[0m                                                                                                    \u001b[1;34m          Host: servera\u001b[0m                                                                                                 "]
[0.000172,"o","\u001b[1;34m          Script location: /home/student/scripts/user_creator.sh\u001b[0m                                                        \u001b[1;34m          Create an account for every name listed in new_users.txt\u001b[0m                                                      \u001b[1;34m          The script must be safe to run twice\u001b[0m                                                                          \u001b[1;34m          Only a privileged user may run it\u001b[0m                                                                             "]
[0.000158,"o","\u001b[1;34m        Steps\u001b[0m                                                                                                           \u001b[1;34m          1. Write the list of accounts to create into an input file\u001b[0m                                                    \u001b[1;34m          2. Create an executable script that reads the file line by line\u001b[0m                                               \u001b[1;34m          3. Create each listed account and report whether it worked\u001b[0m"]
[0.000025,"o","                                                    \u001b[1;34m          4. Refuse to run unless the script was started with root privileges\u001b[0m"]
[0.000171,"o","                                           \u001b[1;34m          5. Skip blank lines, then rerun the script to confirm it is safe to repeat\u001b[0m                                    \u001b[1;34m########################################################################################################################\u001b[0m"]
