[0,"o","\r\u001b[1;34m\u001b[0m                                                                                                                        \u001b[1;34m########################################################################################################################\u001b[0m\u001b[1;34m    Exercise: Item Inspector\u001b[0m                                                                                            \u001b[1;34m        Requirements\u001b[0m                                                                                                    \u001b[1;34m          Host: servera\u001b[0m"]
[0.000043,"o","                                                                                                 \u001b[1;34m          Script location: /home/student/scripts/item_inspector.sh\u001b[0m"]
[0.00017,"o","                                                      \u001b[1;34m          Inspect each path a backup job was told to collect\u001b[0m                                                            "]
[0.000032,"o","\u001b[1;34m          Report each path as a regular file, a directory, or neither\u001b[0m"]
[0.000506,"o","                                                   \u001b[1;34m          Every path must produce exactly one message\u001b[0m                                                                   \u001b[1;34m        Steps\u001b[0m                                                                                                           \u001b[1;34m          1. Create a basic script file\u001b[0m                                                                                 \u001b[1;34m          2. Make it executable and run it\u001b[0m"]
[0.000032,"o","                                                                              \u001b[1;34m          3. Loop over a list of paths and print each one\u001b[0m"]
[0.000165,"o","                                                               \u001b[1;34m          4. Report the paths that are regular files\u001b[0m                                                                    "]
[0.000027,"o","\u001b[1;34m          5. Add a branch for directories, then a final branch for everything else\u001b[0m"]
[0.000186,"o","                                      \u001b[1;34m          6. Confirm that every item in the list produces exactly one message\u001b[0m                                           "]
[0.000022,"o","\u001b[1;34m########################################################################################################################\u001b[0m"]
