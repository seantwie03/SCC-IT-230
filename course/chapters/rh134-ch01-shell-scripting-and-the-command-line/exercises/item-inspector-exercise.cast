[0.000809,"o","#!/bin/bash\r\necho \"Starting $0\"\r\nfor item in /etc/skel /etc/passwd /srv/nightly-backup; do\r\n    if [[ -f \"$item\" ]]; then\r\n        echo \"$item is a file\"\r\n    elif [[ -d \"$item\" ]]; then\r\n        echo \"$item is a directory\""]
[0.000043,"o","\r\n    else\r\n        echo \"$item is neither a file nor a directory\"\r\n    fi\r\ndone\r\n"]
