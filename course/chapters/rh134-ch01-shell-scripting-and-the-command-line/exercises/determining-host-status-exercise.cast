[0.000709,"o","#!/bin/bash\r\necho \"Starting $0\"\r\nfinance_app_ips=\"172.25.250.9 19.19.19.18 172.25.250.10 19.19.19.19 172.25.250.11\"\r\nfor host in $finance_app_ips; do\r\n    echo \"Checking $host...\"\r\n    if ping -c1 -W1 \"$host\" > /dev/null; then\r\n        echo \"$host is UP\"\r\n"]
[0.00005,"o","    else\r\n"]
[0.000092,"o","        echo \"$host is DOWN\"\r\n    fi\r\ndone\r\n"]
