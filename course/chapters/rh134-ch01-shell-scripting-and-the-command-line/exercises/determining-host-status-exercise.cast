[0.000044,"o","                                                              "]
[0.000049,"o","\u001b[1;34m          Report which addresses used by the finance application are reachable\u001b[0m"]
[0.000048,"o","                                          "]
[0.000052,"o","\u001b[1;34m        Steps\u001b[0m"]
[0.000051,"o","                                                                                                           "]
[0.000047,"o","\u001b[1;34m          1. Create a basic script file\u001b[0m"]
[0.000173,"o","                                                                                 \u001b[1;34m          2. Make it executable and run it\u001b[0m                                                                              "]
[0.000126,"o","\u001b[1;34m          3. Loop over a list of addresses and announce each one as it is checked\u001b[0m                                       "]
[0.000394,"o","\u001b[1;34m          4. Branch on the result of ping to report each host as up or down\u001b[0m                                             \u001b[1;34m          5. Silence the ping output so only your own report remains\u001b[0m                                                    \u001b[1;34m          6. Confirm that both a reachable and an unreachable address are reported correctly\u001b[0m                            \u001b[1;34m########################################################################################################################\u001b[0m"]
