[0.000601,"o","#!/bin/bash\r\necho \"Starting $0\"\r\nfinance_app_ips=\"172.25.250.9 19.19.19.18 172.25.250.10 19.19.19.19 172.25.250.11\"\r\nfor host in $finance_app_ips; do\r\n    echo \"Checking $host...\"done\r\n    if ping -c1 -W1 \"$host\" > /dev/null; then\r\n        echo \"$host is UP\"\r\n    else\r\n        echo \"$host is DOWN\"\r\n    fi\r\n"]
[0.000006,"o","\r\n"]
