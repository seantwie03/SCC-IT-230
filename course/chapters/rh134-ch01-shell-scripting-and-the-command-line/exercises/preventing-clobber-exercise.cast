[0,"o","\r\u001b[1;34m\u001b[0m                                                                                                                        \u001b[1;34m########################################################################################################################\u001b[0m\u001b[1;34m    Exercise: Preventing Clobber\u001b[0m                                                                                        "]
[0.000019,"o","\u001b[1;34m        Requirements\u001b[0m"]
[0.00002,"o","                                                                                                    "]
[0.000059,"o","\u001b[1;34m          Hosts: workstation, then servera\u001b[0m                                                                              "]
[0.00005,"o","\u001b[1;34m          Protect an existing file from being overwritten, in this shell and in every shell\u001b[0m"]
[0.000033,"o","                             "]
[0.000029,"o","\u001b[1;34m        Steps\u001b[0m"]
[0.000018,"o","                                                                                                           "]
[0.000125,"o","\u001b[1;34m          1. Create a file holding data you care about\u001b[0m                                                                  \u001b[1;34m          2. Enable noclobber and attempt to overwrite the file with >\u001b[0m                                                  "]
[0.000052,"o","\u001b[1;34m          3. Add to the file with >>, then overwrite it deliberately with >|\u001b[0m                                            "]
[0.000043,"o","\u001b[1;34m          4. Confirm the option is off again in a new session\u001b[0m"]
[0.000015,"o","                                                           "]
[0.000141,"o","\u001b[1;34m          5. Persist noclobber in ~/.bashrc and confirm it applies at next login\u001b[0m                                        \u001b[1;34m########################################################################################################################\u001b[0m"]
[0,"m","Exercise: Preventing Clobber"]
