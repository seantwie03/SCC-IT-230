[0,"o","\r\u001b[1;34m\u001b[0m                                                                                                                        \u001b[1;34m########################################################################################################################\u001b[0m\u001b[1;34m    Exercise: Collecting Disk Data\u001b[0m                                                                                      "]
[0.00004,"o","\u001b[1;34m        Requirements\u001b[0m                                                                                                    "]
[0.000036,"o","\u001b[1;34m          Hosts: servera and workstation\u001b[0m                                                                                "]
[0.000058,"o","\u001b[1;34m          Script location: /home/student/scripts/collect_disk_data.sh\u001b[0m                                                   "]
[0.00003,"o","\u001b[1;34m          The script must accept any number of host names as arguments\u001b[0m"]
[0.000006,"o","                                                  "]
[0.000021,"o","\u001b[1;34m          Run lsblk and df -h on each host\u001b[0m"]
[0.000015,"o","                                                                              "]
[0.000029,"o","\u001b[1;34m          Store the output in /tmp/disk-data/{HOST}-disk-data.txt\u001b[0m"]
[0.00002,"o","                                                       "]
[0.000016,"o","\u001b[1;34m        Steps\u001b[0m"]
[0.000174,"o","                                                                                                           \u001b[1;34m          1. Create a basic script file and run it with bash\u001b[0m                                                            \u001b[1;34m          2. Make it executable and run it with ./\u001b[0m                                                                      \u001b[1;34m          3. Loop over a fixed list of hosts and confirm the loop runs once per host\u001b[0m                                    "]
[0.000021,"o","\u001b[1;34m          4. Get the disk commands working on one host, then move them into the loop\u001b[0m                                    "]
[0.000043,"o","\u001b[1;34m          5. Replace the fixed list with \"$@\" so the caller chooses the hosts\u001b[0m                                           "]
[0.000049,"o","\u001b[1;34m          6. Verify the collected files\u001b[0m"]
[0.000017,"o","                                                                                 "]
[0.000015,"o","\u001b[1;34m########################################################################################################################\u001b[0m"]
