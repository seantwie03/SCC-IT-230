[0.000035,"o","for host in \"$@\"; do"]
[0.000066,"o","\r\n"]
[0.00015,"o","    echo $host > /tmp/disk-data/$host-disk-data.txt\r\n    ssh student@$host lsblk >> /tmp/disk-data/$host-disk-data.txt\r\n    ssh student@$host df -h >> /tmp/disk-data/$host-disk-data.txt\r\n\r\ndone\r\n"]
