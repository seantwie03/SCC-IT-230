[0.004323, "o", "                                                                                                                        \u001b[1;34m########################################################################################################################\u001b[0m"]
[0.000074, "o", "\u001b[1;34m    Task: Copy a File to servera and Back Again\u001b[0m                                                                         "]
[0.000296, "o", "\u001b[1;34m        Requirements\u001b[0m                                                                                                    "]
[0.000223, "o", "\u001b[1;34m          Student hosts: Windows VDI session and servera\u001b[0m                                                                "]
[0.000374, "o", "\u001b[1;34m          Demonstration hosts: workstation and servera\u001b[0m                                                                  "]
[0.000124, "o", "\u001b[1;34m        Tasks\u001b[0m                                                                                                           "]
[0.000147, "o", "\u001b[1;34m          1. Send/Receive a File from VDI to servera\u001b[0m"]
[0.000027, "o", "                                                                    "]
[0.000167, "o", "\u001b[1;34m          2. Upload several files using globbing\u001b[0m"]
[0.000047, "o", "                                                                        "]
[0.000185, "o", "\u001b[1;34m          3. Download several files using globbing\u001b[0m"]
[0.000051, "o", "                                                                      "]
[0.000162, "o", "\u001b[1;34m########################################################################################################################\u001b[0m"]
[0.044596, "o", "\r\n\u001b[?2004l\r"]
[0.000079, "o", "\u001b]0;student@workstation:~\u0007\u001b[?2004h[student@workstation ~]$ "]
[11.333941, "o", "clear"]
[1.063323, "o", "\r\n\u001b[?2004l\r"]
[0.001988, "o", "\u001b[H\u001b[2J"]
[0.000371, "o", "\u001b]0;student@workstation:~\u0007\u001b[?2004h[student@workstation ~]$ "]
[0.342316, "o", "\r"]
[0.003966, "o", "                                                                                                                        \u001b[1;34m########################################################################################################################\u001b[0m"]
[0.000215, "o", "\u001b[1;34m    1. Send/Receive a file between VDI and servera\u001b[0m                                                                      "]
[0.00031, "o", "\u001b[1;34m        1. Open Windows Terminal on the VDI (PowerShell)\u001b[0m                                                                "]
[0.000126, "o", "\u001b[1;34m        2. notepad {YOUR_NAME}.txt\u001b[0m                                                                                      "]
[0.00024, "o", "\u001b[1;34m           - Write your favorite text editor into {YOUR_NAME}.txt and save it\u001b[0m                                           "]
[0.000211, "o", "\u001b[1;34m        3. scp {YOUR_NAME}.txt student@servera:~\u001b[0m                                                                        "]
[0.000339, "o", "\u001b[1;34m        4. ssh student@servera\u001b[0m                                                                                          "]
[0.0001, "o", "\u001b[1;34m        5. ls -l\u001b[0m                                                                                                        "]
[0.00018, "o", "\u001b[1;34m        6. vim {YOUR_NAME}.txt - add the last game, book, or movie you finished\u001b[0m"]
[0.00005, "o", "                                         "]
[0.000143, "o", "\u001b[1;34m        7. exit\u001b[0m"]
[0.000049, "o", "                                                                                                         "]
[0.000169, "o", "\u001b[1;34m        8. scp student@servera:~/{YOUR_NAME}.txt .\u001b[0m"]
[0.000054, "o", "                                                                      "]
[0.000158, "o", "\u001b[1;34m        9. Get-ChildItem\u001b[0m"]
[0.000053, "o", "                                                                                                "]
