[0.00003,"o","\u001b[1;34m    Exercise: Backing Up a Laptop with Anacron\u001b[0m"]
[0.00007,"o","                                                                          "]
[0.00005,"o","\u001b[1;34m        Requirements\u001b[0m"]
[0.000149,"o","                                                                                                    "]
[0.000115,"o","\u001b[1;34m          Host: workstation, standing in for a laptop\u001b[0m"]
[0.000034,"o","                                                                   "]
[0.000021,"o","\u001b[1;34m          Back up /etc about once a day, as root\u001b[0m"]
[0.000031,"o","                                                                        "]
[0.00002,"o","\u001b[1;34m          The machine is closed at night, so a crontab entry would never fire\u001b[0m"]
[0.00002,"o","                                           "]
[0.000024,"o","\u001b[1;34m          Anacron runs an overdue job once the machine is back\u001b[0m"]
[0.000017,"o","                                                          "]
[0.000031,"o","\u001b[1;34m        Tasks\u001b[0m"]
[0.000009,"o","                                                                                                           "]
[0.000054,"o","\u001b[1;34m          1. Write the daily backup script\u001b[0m                                                                              "]
[0.000022,"o","\u001b[1;34m          2. Ask anacron to run what is due\u001b[0m"]
[0.000022,"o","                                                                             "]
[0.000018,"o","\u001b[1;34m          3. Pretend the laptop has been closed since January\u001b[0m"]
[0.000029,"o","                                                           "]
[0.000041,"o","\u001b[1;34m          4. Confirm the backup ran, then clean up\u001b[0m"]
[0.000019,"o","                                                                      "]
