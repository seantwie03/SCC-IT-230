[0,"o","\u001b[1;34m########################################################################################################################\u001b[0m"]
[0.000054,"o","\u001b[1;34m    Exercise: Backing Up /etc/passwd Nightly\u001b[0m"]
[0.000058,"o","                                                                            "]
[0.000044,"o","\u001b[1;34m        Requirements\u001b[0m"]
[0.00006,"o","                                                                                                    "]
[0.000075,"o","\u001b[1;34m          Hosts: servera, then workstation standing in for a laptop\u001b[0m"]
[0.00005,"o","                                                     "]
[0.000054,"o","\u001b[1;34m          Back up /etc/passwd every night at 10 p.m., as root\u001b[0m"]
[0.000052,"o","                                                           "]
[0.000051,"o","\u001b[1;34m          Copy each snapshot to workstation as an offsite copy\u001b[0m"]
[0.000052,"o","                                                          "]
[0.000151,"o","\u001b[1;34m          servera is always on, so a system crontab is the right home\u001b[0m                                                   "]
[0.000049,"o","\u001b[1;34m          workstation is a laptop, so the same script goes to anacron instead\u001b[0m"]
[0.000148,"o","                                           \u001b[1;34m        Tasks\u001b[0m"]
[0.000216,"o","                                                                                                           "]
[0.000049,"o","\u001b[1;34m          1. Write the backup script on servera\u001b[0m"]
[0.000059,"o","                                                                         "]
[0.000074,"o","\u001b[1;34m          2. Schedule it in /etc/cron.d\u001b[0m"]
[0.000047,"o","                                                                                 "]
[0.000152,"o","\u001b[1;34m          3. Find out why nothing happened\u001b[0m                                                                              "]
[0.000061,"o","\u001b[1;34m          4. Confirm root ran it, then set the real 10 p.m. schedule\u001b[0m                                                    "]
[0.000207,"o","\u001b[1;34m          5. Give the same script to anacron on workstation\u001b[0m                                                             \u001b[1;34m          6. Let anacron catch up, then clean up both hosts\u001b[0m                                                             "]
[0.000036,"o","\u001b[1;34m########################################################################################################################\u001b[0m"]
