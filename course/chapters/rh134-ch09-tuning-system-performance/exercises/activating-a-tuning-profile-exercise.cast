[0.000762,"o","#\r\n# tuned configuration\r\n#\r\n\r\n"]
[0.000093,"o","[main]\r\nsummary=Optimize for deterministic performance at the cost of increased power consumption, focused on low latency network performance\r\ninclude=latency-performance\r\n\r\n"]
[0.000014,"o","[vm]"]
[0.000008,"o","\r\n"]
[0.000019,"o","transparent_hugepages=never"]
