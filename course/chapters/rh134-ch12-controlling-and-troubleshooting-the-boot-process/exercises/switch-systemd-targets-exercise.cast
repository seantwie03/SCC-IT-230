[0.00019,"o","                                                                                                    "]
[0.000134,"o","\u001b[1;34m          Host: workstation, with its VM console open\u001b[0m"]
[0.000131,"o","                                                                   \u001b[1;34m          Switch workstation between targets now, by default, and for a single boot\u001b[0m"]
[0.000077,"o","                                     "]
[0.000012,"o","\u001b[1;34m        Steps\u001b[0m"]
[0.000092,"o","                                                                                                           \u001b[1;34m          1. Make the GRUB2 menu appear on every boot\u001b[0m                                                                   \u001b[1;34m          2. Inspect the default target and its dependencies\u001b[0m"]
[0.000036,"o","                                                            \u001b[1;34m          3. Switch to multi-user.target without rebooting\u001b[0m"]
[0.000043,"o","                                                              "]
[0.000019,"o","\u001b[1;34m          4. Make multi-user.target the default and reboot to confirm\u001b[0m"]
[0.000008,"o","                                                   "]
[0.000037,"o","\u001b[1;34m          5. Restore graphical.target as the default\u001b[0m"]
[0.000009,"o","                                                                    "]
[0.000028,"o","\u001b[1;34m          6. Boot once into rescue.target from the GRUB2 menu\u001b[0m"]
[0.000022,"o","                                                           "]
[0.000012,"o","\u001b[1;34m          7. Confirm the root file system is read/write, then continue the boot\u001b[0m"]
[0.00003,"o","                                         "]
