[0,"o","\r\u001b[1;34m\u001b[0m                                                                                                                        \u001b[1;34m########################################################################################################################\u001b[0m\u001b[1;34m    Exercise: Change Kernel Arguments\u001b[0m                                                                                   "]
[0.000154,"o","\u001b[1;34m        Requirements\u001b[0m                                                                                                    \u001b[1;34m          Host: servera, with its VM console open for the GRUB2 menu\u001b[0m                                                    \u001b[1;34m          Boot servera once with an extra kernel argument, then make it persistent\u001b[0m                                      \u001b[1;34m        Steps\u001b[0m                                                                                                           \u001b[1;34m          1. Make the GRUB2 menu appear on every boot\u001b[0m"]
[0.000038,"o","                                                                   \u001b[1;34m          2. Boot once with ipv6.disable=1 added at the GRUB2 menu\u001b[0m"]
[0.000005,"o","                                                      "]
[0.000044,"o","\u001b[1;34m          3. Confirm the argument with /proc/cmdline and ip -br addr\u001b[0m                                                    "]
[0.000042,"o","\u001b[1;34m          4. Reboot without editing and confirm the argument is gone\u001b[0m"]
[0.000013,"o","                                                    "]
[0.000007,"o","\u001b[1;34m          5. Add ipv6.disable=1 persistently with grubby\u001b[0m"]
[0.000033,"o","                                                                "]
[0.000012,"o","\u001b[1;34m          6. Reboot and confirm the argument is still there\u001b[0m"]
[0.000045,"o","                                                             \u001b[1;34m          7. Remove the argument with grubby\u001b[0m"]
[0.00003,"o","                                                                            "]
[0.000011,"o","\u001b[1;34m########################################################################################################################\u001b[0m"]
[0,"m","Exercise: Change Kernel Arguments"]
